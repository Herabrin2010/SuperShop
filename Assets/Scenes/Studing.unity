--- !u!114 &2021977162
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 435277474}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ebf75528f9ab5414eb6a142128d58baf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  chatPanel: {fileID: 1539820729}
  messagePrefab: {fileID: 515377663}
  diologPrefab: {fileID: 326206435}
  messageParent: {fileID: 257530803}
  chatScrollRect: {fileID: 1484136889}
  diologText: {fileID: 326206435}
  phrases:
  - "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0432\u0443\u044E."
  - "\u0412\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C \u0432
    \u0437\u0430\u043A\u0443\u043B\u0438\u0441\u044C\u0435."
  - "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0432\u0430\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
    \u043E\u0441\u0432\u043E\u0438\u0442\u044C\u0441\u044F."
  - "\u041F\u043E\u0441\u043B\u0435 \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435
    \u0441\u0430\u043C\u0438 \u0437\u0430 \u0441\u0435\u0431\u044F."
  - "\u0412\u0430\u0448\u0430 \u0435\u0434\u0438\u043D\u0441\u0432\u0435\u043D\u043D\u0430\u044F
    \u0446\u0435\u043B\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0438 \"\u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C\" \u0438\u0445."
  - "\u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u0432\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \"\u043F\u0440\u043E\u0434\u0430\u0442\u044C\"
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
  - "\u0421\u043C\u043E\u0442\u0440\u0438, \u0432\u0430\u0448\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F
    \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430\u044F \u0437\u043E\u043D\u0430
    \u0431\u0443\u0434\u0435\u0442 \u043E\u0433\u043E\u0440\u043E\u0436\u0435\u043D\u0430
    \u0434\u0432\u0435\u0440\u044C\u043C\u0438."
  - "\u0412\u0430\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043E \u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F
    \u0438\u0445, \u0447\u0442\u043E \u0431\u044B \u043E\u043D\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C"
  - "\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043D\u0443\u0436\u043D\u043E
    \u043A\u043B\u0430\u0441\u0442\u044C \u0432 \u044D\u0442\u043E\u0442 \u044F\u0449\u0438\u043A."
  - "\u041F\u043E\u0434\u043D\u0438\u043C\u0438 \u0441\u0432\u043E\u044E \u043F\u0440\u0430\u0432\u0443\u044E
    \u0440\u0443\u043A\u0443. (\u043A\u043B\u0430\u0432\u0438\u0448\u0430 M)"
  - "\u041D\u0430 \u043D\u0435\u0439 \u0442\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C
    \u0442\u0435\u043A\u0443\u0449\u0435\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435,
    \u0432\u0440\u0435\u043C\u044F \u043E\u0442\u0441\u0430\u0432\u0448\u0435\u0435\u0441\u044F
    \u0443 \u0442\u0435\u0431\u044F \u0438 \u0442\u0432\u043E\u0451 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
  - "\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0432 \u0442\u043E\u043C,
    \u0447\u0442\u043E \u0437\u0430\u043A\u0443\u043B\u0438\u0441\u044C\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
    \u0433\u043E\u043B\u043E\u0434\u043D\u043E."
  - "\u0418 \u0435\u0441\u043B\u0438 \u0442\u044B \u043D\u0435 \u0443\u0441\u043F\u0435\u0435\u0448\u044C
    \u043E\u0442\u0434\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442
    \u0432\u043E\u0432\u0440\u0435\u043C\u044F, \u0442\u044B \u0443\u043C\u0440\u0451\u0448\u044C."
  - "\u0422\u0430\u043A-\u0436\u0435 \u043F\u043E \u0437\u0430\u043A\u0443\u043B\u0438\u0441\u044C\u044E
    \u0431\u0440\u043E\u0434\u0438\u0442 \u043C\u043E\u043D\u0441\u0442\u0440."
  - "\u0415\u0441\u043B\u0438 \u043E\u043D \u0437\u0430\u043C\u0435\u0442\u0438\u0442
    \u0442\u0435\u0431\u044F - \u0411\u0415\u0413\u0418!"
  - "\u0415\u0441\u043B\u0438 \u043F\u043E\u0432\u0435\u0437\u0451\u0442, \u0442\u044B
    \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0443\u0431\u0435\u0436\u0430\u0442\u044C."
  - "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0434\u0430\u0447\u0438!"
